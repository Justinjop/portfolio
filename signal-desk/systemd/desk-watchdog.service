[Unit]
Description=Signal Desk watchdog alerts
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/qt/ops
Environment=HOME=/home/ubuntu
EnvironmentFile=/home/ubuntu/.config/desk/claude.env
ExecStart=/bin/bash -c '/home/ubuntu/venv/bin/python watchdog.py >> watchdog.log 2>&1'
TimeoutStartSec=1500
Nice=5
