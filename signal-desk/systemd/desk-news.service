[Unit]
Description=Hourly crypto news digest to Discord
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/qt/news
EnvironmentFile=/home/ubuntu/.config/desk/claude.env
Environment=HOME=/home/ubuntu
ExecStart=/bin/bash -c '/home/ubuntu/venv/bin/python news.py >> news.log 2>&1'
TimeoutStartSec=900
Nice=5
